{
  "name": "@ssa-ui-kit/utils",
  "version": "3.20.3",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "private": false,
  "sideEffects": false,
  "author": "SSA Group",
  "license": "MIT",
  "description": "SSA UI Kit utilities",
  "keywords": [
    "react",
    "SSA UI Kit",
    "utils"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ssagroup/ui-kit.git",
    "directory": "packages/utils"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node ../../scripts/clean.mjs",
    "build": "node ../../scripts/clean.mjs && webpack --mode=production --node-env=production && node ../../scripts/verify-esm-bundle.mjs && tsc --build ./tsconfig.build.json && resolve-tspaths -p ./tsconfig.build.json",
    "ts-show-config": "tsc --showConfig -p ./tsconfig.json",
    "ts-show-config-build": "tsc --showConfig -p ./tsconfig.build.json",
    "ts-check": "tsc -p ./tsconfig.json",
    "ts-check-build": "tsc -p ./tsconfig.build.json"
  },
  "browserslist": [
    ">0.1%",
    "not dead",
    "not op_mini all"
  ],
  "module": "dist/index.mjs"
}
